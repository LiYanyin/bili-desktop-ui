{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "TaskCreate",
      "TaskUpdate",
      "EnterWorktree",
      "ExitWorktree",
      "Skill",
      "Agent",
      "NotebookEdit",
      "mcp__*"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(format *)",
      "Bash(shutdown *)",
      "Bash(reg *)",
      "Bash(sc *)",
      "Bash(netsh *)"
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "skipDangerousModePermissionPrompt": true
}